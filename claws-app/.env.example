GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_APP_URL=https://claws.chatrecept.chat

# Supabase (same project as the rest of ChatRecept; auth + app_claws.users table)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Comma-separated email allowlist — these users are auto-promoted to admin
# on first Google sign-in (mirrors the secretariat pattern).
ADMIN_EMAILS=mjoechia@gmail.com

# Per-user daily spend cap (SGD). Generous enough for a genuine prospect to
# try ~20 fresh lookups in a day; admin can disable specific abusers.
MAX_DAILY_SPEND_PER_USER_SGD=20

# Per-IP daily spend cap (SGD) — defence-in-depth on top of per-user.
# At ~SGD 0.95 / uncached lookup, SGD 20 ≈ 21 fresh lookups per IP per day.
MAX_DAILY_SPEND_PER_IP_SGD=20

# Global daily spend cap (SGD) — safety net across all users + IPs. When
# exceeded, only cached lookups are served.
MAX_DAILY_SPEND_SGD=50

# Secret token for /api/prep/warm — generate with: openssl rand -hex 32
WARM_TOKEN=
