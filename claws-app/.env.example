GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_APP_URL=https://claws.chatrecept.chat

# Per-IP daily spend cap (SGD) — primary abuse defence.
# At ~SGD 0.95 / uncached lookup (6-source discovery + 10× Place Details + buffer),
# SGD 20 allows ~21 fresh lookups per IP per day.
MAX_DAILY_SPEND_PER_IP_SGD=20

# Global daily spend cap (SGD) — safety net across all IPs. When exceeded,
# only cached lookups (example zones, pre-warmed prospect links) are served.
# Recommend 50 to cover ~50 fresh visitors per day after the discovery widen.
MAX_DAILY_SPEND_SGD=50

# Secret token for /api/prep/warm — generate with: openssl rand -hex 32
WARM_TOKEN=
